# =============================================
# REQUIRED: At least one LLM API key
# =============================================
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# =============================================
# LLM Provider & Model
# =============================================
LLM_PROVIDER=gemini  # gemini | groq | openai | deepseek | zhipuai
GEMINI_MODEL_NAME=gemini-2.0-flash
GROQ_MODEL_NAME=llama-3.3-70b-versatile
OPENAI_MODEL_NAME=gpt-4o-mini
DEEPSEEK_MODEL_NAME=deepseek-chat
ZHIPUAI_MODEL_NAME=glm-4-flash

# =============================================
# Neo4j (GraphRAG) — Required if ENABLE_GRAPH_RAG=True
# =============================================
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# =============================================
# Embedding Model
# =============================================
EMBEDDING_MODEL_NAME=google/embeddinggemma-300m
RERANKING_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# =============================================
# Feature Flags
# =============================================
ENABLE_GRAPH_RAG=True
ENABLE_VECTOR_RAG=False

# =============================================
# Environment
# =============================================
APP_ENV=aws  # local | aws

# =============================================
# Retrieval Settings
# =============================================
TOP_K_RETRIEVAL=7
TOP_K_RERANK=5
